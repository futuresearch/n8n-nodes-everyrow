{
  "name": "n8n-nodes-everyrow",
  "version": "0.1.0",
  "description": "n8n community node for Everyrow - AI-powered data operations including ranking, deduplication, merging, screening, and agent workflows",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "everyrow",
    "ai",
    "data-operations",
    "ranking",
    "deduplication"
  ],
  "license": "MIT",
  "homepage": "https://github.com/futuresearch/n8n-nodes-everyrow",
  "author": {
    "name": "Futuresearch",
    "email": "support@futuresearch.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuresearch/n8n-nodes-everyrow.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "dist/nodes/Everyrow/Everyrow.node.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/EveryrowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Everyrow/Everyrow.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.22.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
