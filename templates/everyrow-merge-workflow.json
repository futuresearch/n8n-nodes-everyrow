      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Left table: Companies we want to enrich\nconst leftTable = [\n  { company_name: \"OpenAI\", notes: \"Interested in partnership\" },\n  { company_name: \"Anthropic\", notes: \"Potential customer\" },\n  { company_name: \"Stripe\", notes: \"Payment provider\" },\n  { company_name: \"Databricks\", notes: \"Data platform\" }\n];\n\n// Right table: Company details to merge in\nconst rightTable = [\n  { name: \"OpenAI\", founded: 2015, headquarters: \"San Francisco\", employees: 1500 },\n  { name: \"Anthropic\", founded: 2021, headquarters: \"San Francisco\", employees: 500 },\n  { name: \"Stripe Inc.\", founded: 2010, headquarters: \"San Francisco\", employees: 8000 },\n  { name: \"Databricks Inc\", founded: 2013, headquarters: \"San Francisco\", employees: 5000 },\n  { name: \"Google\", founded: 1998, headquarters: \"Mountain View\", employees: 180000 }\n];\n\nreturn [{ json: { leftTable, rightTable } }];"
      },
      "id": "sample-data",
      "name": "Sample Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://engine.futuresearch.ai/sessions/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: \"n8n-merge-\" + Date.now() }) }}",
        "options": {}
      },
      "id": "create-session",
      "name": "Create Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://engine.futuresearch.ai/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  session_id: $json.session_id,\n  payload: {\n    task_type: \"create_group\",\n    query: {\n      data_to_create: $('Sample Data').first().json.leftTable\n    }\n  }\n}) }}",
        "options": {}
      },
      "id": "create-left-artifact",
      "name": "Create Left Table",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
