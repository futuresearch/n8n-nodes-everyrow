{
  "name": "Everyrow Screen Example",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Sample data: Companies to screen/filter\nconst companies = [\n  { name: \"OpenAI\", description: \"AI research company, creators of GPT models\", industry: \"AI\" },\n  { name: \"Stripe\", description: \"Payment processing platform for internet businesses\", industry: \"Fintech\" },\n  { name: \"Anthropic\", description: \"AI safety company, creators of Claude\", industry: \"AI\" },\n  { name: \"Snowflake\", description: \"Cloud data warehousing and analytics platform\", industry: \"Data\" },\n  { name: \"Databricks\", description: \"Unified analytics platform for big data and AI\", industry: \"Data/AI\" },\n  { name: \"Figma\", description: \"Collaborative design tool for UI/UX\", industry: \"Design\" },\n  { name: \"Scale AI\", description: \"Data labeling and AI infrastructure company\", industry: \"AI\" },\n  { name: \"Notion\", description: \"All-in-one workspace for notes and collaboration\", industry: \"Productivity\" }\n];\n\nreturn [{ json: { companies } }];"
      },
      "id": "sample-data",
      "name": "Sample Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://engine.futuresearch.ai/api/v0/operations/screen",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  input: $json.companies,\n  task: \"Filter to only include companies that are primarily focused on AI/ML. Companies should be building AI models, AI infrastructure, or AI-powered products as their core business.\",\n  response_schema: {\n    type: \"object\",\n    properties: {\n      included: { type: \"boolean\", description: \"Whether the company passes the AI/ML filter\" },\n      reasoning: { type: \"string\", description: \"Explanation for the decision\" }\n    },\n    required: [\"included\"]\n  }\n}) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "submit-screen",
      "name": "Submit Screen Operation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://engine.futuresearch.ai/api/v0/tasks/{{ $json.task_id }}/status",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "poll-status",
      "name": "Poll Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-done",
      "name": "Task Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://engine.futuresearch.ai/api/v0/tasks/{{ $('Submit Screen Operation').first().json.task_id }}/status",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "repoll",
      "name": "Re-poll Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://engine.futuresearch.ai/api/v0/tasks/{{ $('Submit Screen Operation').first().json.task_id }}/result",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "fetch-results",
      "name": "Fetch Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract the screened results\nconst response = $input.first().json;\n\nif (response.data && Array.isArray(response.data)) {\n  return response.data.map(item => ({ json: item }));\n}\n\nif (response.data) {\n  return [{ json: response.data }];\n}\n\nreturn [{ json: { error: \"No data in response\", raw: response } }];"
      },
      "id": "parse-results",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [[{ "node": "Sample Data", "type": "main", "index": 0 }]]
    },
    "Sample Data": {
      "main": [[{ "node": "Submit Screen Operation", "type": "main", "index": 0 }]]
    },
    "Submit Screen Operation": {
      "main": [[{ "node": "Poll Status", "type": "main", "index": 0 }]]
    },
    "Poll Status": {
      "main": [[{ "node": "Task Done?", "type": "main", "index": 0 }]]
    },
    "Task Done?": {
      "main": [
        [{ "node": "Fetch Results", "type": "main", "index": 0 }],
        [{ "node": "Wait 5s", "type": "main", "index": 0 }]
      ]
    },
    "Wait 5s": {
      "main": [[{ "node": "Re-poll Status", "type": "main", "index": 0 }]]
    },
    "Re-poll Status": {
      "main": [[{ "node": "Task Done?", "type": "main", "index": 0 }]]
    },
    "Fetch Results": {
      "main": [[{ "node": "Parse Results", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
