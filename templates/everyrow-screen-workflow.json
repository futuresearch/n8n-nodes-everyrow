      "parameters": {
        "jsCode": "// Extract the screened results from the artifact response\nconst response = $input.first().json;\nconst artifacts = Array.isArray(response) ? response : [response];\n\nif (artifacts[0]?.artifacts) {\n  return artifacts[0].artifacts.map(a => ({ json: a.data }));\n}\n\nreturn [{ json: { error: \"Unexpected response format\", raw: response } }];"
      },
