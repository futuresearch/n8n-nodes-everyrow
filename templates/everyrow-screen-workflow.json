    {
      "parameters": {
        "jsCode": "// Sample data: Companies to screen/filter\nconst companies = [\n  { name: \"OpenAI\", description: \"AI research company, creators of GPT models\", industry: \"AI\" },\n  { name: \"Stripe\", description: \"Payment processing platform for internet businesses\", industry: \"Fintech\" },\n  { name: \"Anthropic\", description: \"AI safety company, creators of Claude\", industry: \"AI\" },\n  { name: \"Snowflake\", description: \"Cloud data warehousing and analytics platform\", industry: \"Data\" },\n  { name: \"Databricks\", description: \"Unified analytics platform for big data and AI\", industry: \"Data/AI\" },\n  { name: \"Figma\", description: \"Collaborative design tool for UI/UX\", industry: \"Design\" },\n  { name: \"Scale AI\", description: \"Data labeling and AI infrastructure company\", industry: \"AI\" },\n  { name: \"Notion\", description: \"All-in-one workspace for notes and collaboration\", industry: \"Productivity\" }\n];\n\n// Return single item with all companies\nreturn [{ json: { companies } }];"
      },
      "id": "sample-data",
      "name": "Sample Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://engine.futuresearch.ai/sessions/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: \"n8n-screen-\" + Date.now() }) }}",
        "options": {}
      },
      "id": "create-session",
      "name": "Create Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://engine.futuresearch.ai/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  session_id: $json.session_id,\n  payload: {\n    task_type: \"create_group\",\n    query: {\n      data_to_create: $('Sample Data').first().json.companies\n    }\n  }\n}) }}",
        "options": {}
      },
