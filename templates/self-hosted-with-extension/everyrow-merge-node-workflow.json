{
  "name": "Everyrow Merge with Polling (Node)",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Left table: Companies we want to enrich\nreturn [\n  { json: { company_name: \"OpenAI\", notes: \"Interested in partnership\" } },\n  { json: { company_name: \"Anthropic\", notes: \"Potential customer\" } },\n  { json: { company_name: \"Stripe\", notes: \"Payment provider\" } }\n];"
      },
      "id": "sample-data",
      "name": "Sample Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "dataOperations",
        "operation": "merge",
        "task": "Match companies from the left table with their corresponding entries in the right table based on company name.",
        "rightTable": "[{\"name\": \"OpenAI\", \"founded\": 2015, \"employees\": 1500}, {\"name\": \"Anthropic\", \"founded\": 2021, \"employees\": 500}, {\"name\": \"Stripe Inc.\", \"founded\": 2010, \"employees\": 8000}]"
      },
      "id": "submit-merge",
      "name": "Submit Merge",
      "type": "n8n-nodes-everyrow.everyrow",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": {
        "everyrowApi": {
          "id": "",
          "name": "Everyrow API"
        }
      }
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [900, 300],
      "webhookId": ""
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getStatus",
        "taskId": "={{ $('Submit Merge').item.json.task_id }}"
      },
      "id": "check-status",
      "name": "Check Status",
      "type": "n8n-nodes-everyrow.everyrow",
      "typeVersion": 1,
      "position": [1120, 300],
      "credentials": {
        "everyrowApi": {
          "id": "",
          "name": "Everyrow API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "completed-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-completed",
      "name": "If Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getResult",
        "taskId": "={{ $('Submit Merge').item.json.task_id }}"
      },
      "id": "get-result",
      "name": "Get Result",
      "type": "n8n-nodes-everyrow.everyrow",
      "typeVersion": 1,
      "position": [1560, 200],
      "credentials": {
        "everyrowApi": {
          "id": "",
          "name": "Everyrow API"
        }
      }
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [[{ "node": "Sample Data", "type": "main", "index": 0 }]]
    },
    "Sample Data": {
      "main": [[{ "node": "Submit Merge", "type": "main", "index": 0 }]]
    },
    "Submit Merge": {
      "main": [[{ "node": "Wait 5s", "type": "main", "index": 0 }]]
    },
    "Wait 5s": {
      "main": [[{ "node": "Check Status", "type": "main", "index": 0 }]]
    },
    "Check Status": {
      "main": [[{ "node": "If Completed", "type": "main", "index": 0 }]]
    },
    "If Completed": {
      "main": [
        [{ "node": "Get Result", "type": "main", "index": 0 }],
        [{ "node": "Wait 5s", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
